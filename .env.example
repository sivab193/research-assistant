# Choose: lmstudio, openrouter, or auto (local first, OpenRouter fallback)
LLM_PROVIDER=lmstudio

# Local inference through LM Studio
LM_STUDIO_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL=qwen3-8b-mlx

# Cloud inference through OpenRouter. Never commit your real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Research search API (optional but recommended)
OPENALEX_API_KEY=

MAX_SOURCE_CHARS=70000
PORT=5000
